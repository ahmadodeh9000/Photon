<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="notepad95" _name="Notepad 95" version="1.0">
  <author>Ahmad Odeh</author>
  <_description>Black on white, keyword colors of the mid-90s Windows IDEs</_description>

  <!-- Editor -->
  <style name="text"                    foreground="#000000" background="#FFFFFF"/>
  <style name="selection"               foreground="#FFFFFF" background="#000080"/>
  <style name="selection-unfocused"     foreground="#FFFFFF" background="#C0C0C0"/>
  <style name="cursor"                  foreground="#000000"/>
  <style name="current-line"            background="#FFFFE8"/>
  <style name="line-numbers"            foreground="#808080" background="#C0C0C0"/>
  <style name="current-line-number"     foreground="#000000" background="#C0C0C0" bold="true"/>
  <style name="bracket-match"           foreground="#FFFFFF" background="#000080" bold="true"/>
  <style name="bracket-mismatch"        foreground="#FFFFFF" background="#FF0000" bold="true"/>
  <style name="right-margin"            foreground="#808080" background="#C0C0C0"/>
  <style name="draw-spaces"             foreground="#008000"/>
  <style name="search-match"            foreground="#000000" background="#FFFF00"/>

  <!-- Shared by every language -->
  <style name="def:comment"             foreground="#008000" italic="true"/>
  <style name="def:shebang"             foreground="#008000"/>
  <style name="def:doc-comment-element" foreground="#008000" bold="true"/>
  <style name="def:keyword"             foreground="#0000FF" bold="true"/>
  <style name="def:statement"           foreground="#0000FF" bold="true"/>
  <style name="def:type"                foreground="#0000FF"/>
  <style name="def:string"              foreground="#800000"/>
  <style name="def:character"           foreground="#800000"/>
  <style name="def:special-char"        foreground="#FF00FF"/>
  <style name="def:number"              foreground="#008080"/>
  <style name="def:decimal"             foreground="#008080"/>
  <style name="def:floating-point"      foreground="#008080"/>
  <style name="def:base-n-integer"      foreground="#008080"/>
  <style name="def:complex"             foreground="#008080"/>
  <style name="def:boolean"             foreground="#008080"/>
  <style name="def:constant"            foreground="#008080"/>
  <style name="def:special-constant"    foreground="#008080"/>
  <style name="def:builtin"             foreground="#000000"/>
  <style name="def:function"            foreground="#000000"/>
  <style name="def:identifier"          foreground="#000000"/>
  <style name="def:operator"            foreground="#000000"/>
  <style name="def:preprocessor"        foreground="#800080"/>
  <style name="def:error"               foreground="#FFFFFF" background="#FF0000"/>
  <style name="def:warning"             foreground="#FFFFFF" background="#808000"/>
  <style name="def:note"                foreground="#FFFFFF" background="#000080"/>
  <style name="def:net-address"         foreground="#800000" underline="true"/>

  <!-- Lunar (lang/lunar.lang) -->
  <style name="lunar:control-flow"      foreground="#0000FF" bold="true"/>
  <style name="lunar:declaration"       foreground="#0000FF" bold="true"/>
  <style name="lunar:self-super"        foreground="#0000FF" bold="true"/>
  <style name="lunar:interpolation"     foreground="#FF00FF" bold="true"/>
  <style name="lunar:escape"            foreground="#FF00FF"/>
  <style name="lunar:invalid-escape"    foreground="#FFFFFF" background="#FF0000"/>
  <style name="lunar:map-key"           foreground="#000000"/>
  <style name="lunar:struct-name"       foreground="#0000FF"/>
  <style name="lunar:constructor-call"  foreground="#0000FF"/>
  <style name="lunar:function-name"     foreground="#000000" bold="true"/>
  <style name="lunar:nil"               foreground="#008080"/>
</style-scheme>
