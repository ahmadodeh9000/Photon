<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="hotdog" _name="Hot Dog Stand" version="1.0">
  <author>Ahmad Odeh</author>
  <_description>Black on mustard yellow with ketchup red, after the Windows 3.1 scheme</_description>

  <!-- Editor -->
  <style name="text"                    foreground="#000000" background="#FFFF00"/>
  <style name="selection"               foreground="#FFFFFF" background="#FF0000"/>
  <style name="selection-unfocused"     foreground="#FFFFFF" background="#FF8080"/>
  <style name="cursor"                  foreground="#000000"/>
  <style name="current-line"            background="#FFFF80"/>
  <style name="line-numbers"            foreground="#FFFF00" background="#FF0000"/>
  <style name="current-line-number"     foreground="#FFFFFF" background="#FF0000" bold="true"/>
  <style name="bracket-match"           foreground="#FFFFFF" background="#FF0000" bold="true"/>
  <style name="bracket-mismatch"        foreground="#FFFFFF" background="#000000" bold="true"/>
  <style name="right-margin"            foreground="#FFFF00" background="#FF0000"/>
  <style name="draw-spaces"             foreground="#808000"/>
  <style name="search-match"            foreground="#FFFF00" background="#000000"/>

  <!-- Shared by every language -->
  <style name="def:comment"             foreground="#808000" italic="true"/>
  <style name="def:shebang"             foreground="#808000"/>
  <style name="def:doc-comment-element" foreground="#808000" bold="true"/>
  <style name="def:keyword"             foreground="#FF0000" bold="true"/>
  <style name="def:statement"           foreground="#FF0000" bold="true"/>
  <style name="def:type"                foreground="#800000"/>
  <style name="def:string"              foreground="#0000FF"/>
  <style name="def:character"           foreground="#0000FF"/>
  <style name="def:special-char"        foreground="#FF00FF"/>
  <style name="def:number"              foreground="#008000"/>
  <style name="def:decimal"             foreground="#008000"/>
  <style name="def:floating-point"      foreground="#008000"/>
  <style name="def:base-n-integer"      foreground="#008000"/>
  <style name="def:complex"             foreground="#008000"/>
  <style name="def:boolean"             foreground="#008000"/>
  <style name="def:constant"            foreground="#008000"/>
  <style name="def:special-constant"    foreground="#008000"/>
  <style name="def:builtin"             foreground="#000000"/>
  <style name="def:function"            foreground="#000000"/>
  <style name="def:identifier"          foreground="#000000"/>
  <style name="def:operator"            foreground="#000000"/>
  <style name="def:preprocessor"        foreground="#800080"/>
  <style name="def:error"               foreground="#FFFFFF" background="#000000"/>
  <style name="def:warning"             foreground="#FFFFFF" background="#808000"/>
  <style name="def:note"                foreground="#FFFFFF" background="#FF0000"/>
  <style name="def:net-address"         foreground="#0000FF" underline="true"/>

  <!-- Lunar (lang/lunar.lang) -->
  <style name="lunar:control-flow"      foreground="#FF0000" bold="true"/>
  <style name="lunar:declaration"       foreground="#FF0000" bold="true"/>
  <style name="lunar:self-super"        foreground="#FF0000" bold="true"/>
  <style name="lunar:interpolation"     foreground="#FF00FF" bold="true"/>
  <style name="lunar:escape"            foreground="#FF00FF"/>
  <style name="lunar:invalid-escape"    foreground="#FFFFFF" background="#000000"/>
  <style name="lunar:map-key"           foreground="#000000"/>
  <style name="lunar:struct-name"       foreground="#800000"/>
  <style name="lunar:constructor-call"  foreground="#800000"/>
  <style name="lunar:function-name"     foreground="#000000" bold="true"/>
  <style name="lunar:nil"               foreground="#008000"/>
</style-scheme>
